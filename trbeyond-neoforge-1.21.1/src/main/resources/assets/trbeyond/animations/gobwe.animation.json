
{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.gobwe": {
			"initial_state": "idle",
			"states": {
				"idle1": {
					"animations": ["idle1"],
					"transitions": [
						{"attacking": "q.is_dagger_strike || q.is_double_dagger_strike"},
						{"run": "q.modified_move_speed > 0.1"},
						{"walk": "q.modified_move_speed > 0.01"}
					]
				},
				"idle2": {
					"animations": ["idle2"],
					"transitions": [
						{"attacking": "q.is_dagger_strike || q.is_double_dagger_strike"},
						{"run": "q.modified_move_speed > 0.1"},
						{"walk": "q.modified_move_speed > 0.01"}
					]
				},
				"idle3": {
					"animations": ["idle3"],
					"transitions": [
						{"attacking": "q.is_dagger_strike || q.is_double_dagger_strike"},
						{"run": "q.modified_move_speed > 0.1"},
						{"walk": "q.modified_move_speed > 0.01"}
					]
				},
				"run": {
					"animations": ["run"],
					"transitions": [
						{"attacking": "q.is_dagger_strike || q.is_double_dagger_strike"},
						{"idle1": "q.modified_move_speed < 0.1"},
						{"walk": "q.modified_move_speed < 0.1"}
					]
				},
				"walk": {
					"animations": ["walk"],
					"transitions": [
						{"attacking": "q.is_dagger_strike || q.is_double_dagger_strike"},
						{"idle1": "q.modified_move_speed < 0.1"},
						{"run": "q.modified_move_speed > 0.1"}
					]
				},
				"dagger_strike": {
					"animations": ["dagger_strike"],
					"transitions": [
						{"idle": "!q.is_dagger_strike && q.all_animations_finished"}
					]
				},
				"double_dagger_strike": {
					"animations": ["double_dagger_strike"],
					"transitions": [
						{"idle": "!q.is_double_dagger_strike && q.all_animations_finished"}
					]
				}
			}
		}
	},
